# Secrets — jamais commités
.env

# Config voix liée au compte ElevenLabs (perso) — un .example est fourni
references/profiles/*/voice-config.json

# Contenu de production (tes vidéos : audio, images, mp4, scripts, configs de projet)
projects/*
!projects/.gitkeep
!projects/_example/
!projects/_example/**

# Dépendances et build
node_modules/

# Logs et temporaires
*.log
**/_font.ttf
tmp/

# Profil Chrome d'enregistrement (sessions actives — vaut un mot de passe)
.chrome-record/

# Temporaires de capture video
.recording-tmp/

# Sorties de demo regenerables (demo-recording.bat) — jamais versionnees
demo-*.mp4

# Dossiers de mise au rebut, en attente de suppression par l'humain
_POUBELLE-*/
